# PUBLIC build-time values; these are visible in the installed app. Never add secrets.
# Leave disabled by default. Enable only for an approved Android development build.
EXPO_PUBLIC_OPENFIND_AUTH_ENABLED=false
# Canonical HTTPS origin only (ASCII DNS name/IPv4; no path, query, userinfo or fragment).
EXPO_PUBLIC_OPENFIND_API_ORIGIN=
# Google OAuth Web client ID (public), matching the backend verifier audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
