# Server-only Neon PostgreSQL connection URL. Do not commit credentials.
# Use separate databases/credentials for Development, Preview and Production.
# Generate migrations without this value; set it in .env.local before applying.
DATABASE_URL=

# Better Auth server-side configuration. Never commit actual values.
# Canonical HTTPS origin in deployed environments; localhost HTTP only for development.
BETTER_AUTH_URL=
# Generate at least 32 random bytes (e.g. openssl rand -base64 32) and keep private.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mobile auth is disabled until explicitly enabled after staging/security review.
# A canonical HTTPS BETTER_AUTH_URL is required; the Web client above must match
# the Android Credential Manager server-client ID. Never put secrets in the app.
OPENFIND_MOBILE_AUTH_ENABLED=false
GOOGLE_ANDROID_CLIENT_ID=
# Independent random secret used to HMAC IP rate-limit buckets; at least 32 characters.
MOBILE_AUTH_RATE_SECRET=
# Vercel supplies this as a Bearer token to scheduled cleanup; at least 32 characters.
CRON_SECRET=
